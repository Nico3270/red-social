+  const tiers = keys.map((key) =>
+    city === "Tunja"
+      ? key.includes("-local-")
+        ? 0
+        : key.includes("-dept-")
+          ? 1
+          : 2
+      : key.includes("-national-")
+        ? 0
+        : 2,
+  );
+  expect(tiers).toEqual([...tiers].sort());
+  expect(new Set(keys).size).toBe(keys.length);
+}
