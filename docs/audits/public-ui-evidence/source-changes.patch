+/** Characterization of outstanding geography defects; no database or query changes. */
+import type { RawBusiness } from "./selects";
+
+const mockFindMany = jest.fn();
+jest.mock("@/lib/prisma", () => ({
+  __esModule: true,
+  default: { negocio: { findMany: mockFindMany } },
+}), { virtual: true });
+jest.mock("./mapItem", () => ({
+  mapToFeedItem: (raw: RawBusiness) => ({ id: raw.id, type: "business", data: { ...raw } }),
+}));
+
+import { getFeedDataByType } from "./getFeedData";
+import { getFeedDataByCategory } from "./getFeedDataByCategory";
+
+const business = (id: string, ciudad = "Bogotá", orden = 0): RawBusiness => ({
+  id, nombre: id, slug: id, ciudad, departamento: ciudad === "Bogotá" ? "Bogotá D.C." : "Boyacá",
+  descripcion: "", telefonoContacto: null, fotoPerfil: null, fotoPortada: null,
+  urlGoogleMaps: null, latitud: null, longitud: null, estado: "activo", orden,
+  createdAt: new Date("2026-01-01"), categorias: [], secciones: [],
+  _count: { followsIn: 0, publicaciones: 0, Product: 0, Servicio: 0 },
+} as RawBusiness);
+
+const params = { ciudad: "Bogotá", departamento: "Bogotá D.C.", limit: 2, seenIds: [], followedBusinessIds: [] };
+
+beforeEach(() => { mockFindMany.mockReset(); });
+
+it("sufficient local supply does not need other cities", async () => {
+  mockFindMany.mockResolvedValueOnce(Array.from({ length: 12 }, (_, i) => business(`local-${i}`)));
+  const result = await getFeedDataByType("businesses", params);
+  expect(mockFindMany).toHaveBeenCalledTimes(1);
+  expect(result.items).toHaveLength(2);
+  expect(result.items.every(item => (item.data as unknown as RawBusiness).ciudad === "Bogotá")).toBe(true);
+});
+
+it("scarce local supply expands and deduplicates overlapping national candidates", async () => {
+  const local = business("local"), national = business("national", "Tunja");
+  mockFindMany.mockResolvedValueOnce([local]).mockResolvedValueOnce([]).mockResolvedValueOnce([local, national]);
+  const result = await getFeedDataByType("businesses", params);
+  expect(result.items.map(item => item.id)).toEqual(["local", "national"]);
+  expect(mockFindMany).toHaveBeenCalledTimes(3);
+});
+
+it("absent local supply still shows other cities", async () => {
+  mockFindMany.mockResolvedValueOnce([]).mockResolvedValueOnce([]).mockResolvedValueOnce([business("national", "Tunja")]);
+  const result = await getFeedDataByType("businesses", params);
+  expect(result.items.map(item => item.id)).toEqual(["national"]);
+});
+
+it("AUDIT GEO-01: a highly ranked other-city business can precede the local result", async () => {
+  mockFindMany.mockResolvedValueOnce([business("local")]).mockResolvedValueOnce([]).mockResolvedValueOnce([business("national", "Tunja", 100)]);
+  const result = await getFeedDataByType("businesses", params);
+  // This documents the defect, not the required product behavior. Replace with
+  // a local-first assertion when GEO-01 is fixed in the next batch.
+  expect(result.items.map(item => item.id)).toEqual(["national", "local"]);
+});
+
+it("AUDIT GEO-02: cursor points to an unreturned buffer candidate", async () => {
+  mockFindMany.mockResolvedValueOnce(Array.from({ length: 12 }, (_, i) => business(`local-${i}`)));
+  const result = await getFeedDataByType("businesses", params);
+  expect(result.items.map(item => item.id)).not.toContain(result.nextCursor);
+  expect(result.nextCursor).toBeDefined();
+});
+
+it("category expansion keeps the category predicate in all three geographic queries", async () => {
+  mockFindMany.mockResolvedValue([]);
+  await getFeedDataByCategory("businesses", { ...params, categoriaSlug: "comida" });
+  for (const [query] of mockFindMany.mock.calls) {
+    expect(query.where.AND[1].categorias).toEqual({ some: { category: { slug: "comida" } } });
+  }
+});
