--- /dev/null
+++ src/feed/componentes/followButton.module.css
@@ -0,0 +1,49 @@
+/* Opt-in presentation only; the original desktop icon keeps its layout. */
+.legacyIcon {
+  display: contents;
+}
+.avatarIcon {
+  display: none;
+}
+.feedback {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  overflow: hidden;
+  clip-path: inset(50%);
+  white-space: nowrap;
+}
+@media (max-width: 768px) {
+  .avatarPresentation .legacyIcon {
+    display: none;
+  }
+  .avatarPresentation .avatarIcon {
+    position: absolute;
+    top: 8px;
+    left: 4px;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    width: 12px;
+    height: 12px;
+    pointer-events: none;
+  }
+  .avatarIcon svg {
+    width: 12px;
+    height: 12px;
+  }
+  .spinner {
+    animation: follow-spin 800ms linear infinite;
+  }
+  @media (prefers-reduced-motion: reduce) {
+    .spinner {
+      animation: none;
+    }
+  }
+}
+@keyframes follow-spin {
+  to {
+    transform: rotate(360deg);
+  }
+}
