// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id              String        @id @default(uuid())
  nombre          String
  apellido        String
  username        String        @unique
  contraseña     String
  email           String        @unique
  ciudad          String
  departamento    String
  pais            String?       @default("Colombia")
  genero          Genero
  fechaNacimiento DateTime
  fotoPerfil      String?
  biografia       String?
  role            Role          @default(user)
  facebook        String?
  instagram       String?
  tiktok          String?
  youtube         String?
  twitter         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  ultimaActividad DateTime      @default(now())
  estado          EstadoUsuario @default(activo)
  emailVerified   DateTime?
  negocio         Negocio?      @relation // Relación uno-a-uno
  preferencias    String[]
  publicaciones   Publicacion[]
  interacciones   Interaccion[] @relation("UsuarioInteracciones")
  Transaction     Transaction[]
  orders          Order[] // 🔹 Campo inverso para relación con Order
  reservations    Reservation[] // relación 1:N
  followsOut Follow[] @relation("Follower")     // Follows que este usuario inicia
  followsIn  Follow[] @relation("FollowedUser") // Follows recibidos como usuario

  // Relaciones inversas
  respuestas Respuesta[] @relation("UsuarioRespuestas")
  resenas    Resena[]
  encuestas  Encuesta[]  @relation("UsuarioEncuestas")

  @@index([username])
  @@index([email])
  @@index([role])
}

enum EstadoUsuario {
  activo
  suspendido
  eliminado
}

enum Role {
  admin
  user
  navegante
  creador
  negocio
}

enum Genero {
  masculino
  femenino
  otro
}

model Negocio {
  id               String            @id @default(uuid())
  usuarioId        String            @unique
  usuario          Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nombre           String
  slug             String            @unique
  categorias       NegocioCategory[]
  secciones        NegocioSection[]
  descripcion      String?
  ciudad           String
  departamento     String
  direccion        String? // Nuevo: Dirección legible
  urlGoogleMaps    String?
  latitud          Float?
  longitud         Float?
  horarios         Json?
  imagenes         String[]
  fotoPerfil       String?
  fotoPortada      String?
  sitioWeb         String?
  telefonoContacto String?
  Product          Product[]
  estado           EstadoNegocio     @default(activo)

  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  publicaciones Publicacion[] // Relación para reseñas y anuncios
  orders        Order[] // 🔹 Campo inverso para relación con Order
  // 🔹 Campos inversos agregados
  availability  BusinessAvailability? // relación 1:1
  reservations  Reservation[] // relación 1:N
  Servicio      Servicio[]
  encuestas     Encuesta[]            @relation("NegocioEncuestas")
  preguntas     Pregunta[]            @relation("NegocioPreguntas")
  followsIn  Follow[] @relation("FollowedBusiness") // Follows recibidos como negocio, con name para match

  @@index([ciudad])
  @@index([departamento])
  @@index([estado])
  @@index([usuarioId])
}

model Follow {
  id                String   @id @default(cuid())
  followerId        String   // ID del seguidor (Usuario)
  followedUserId    String?  // ID para Usuario seguido (setear si type USER_TO_USER o BUSINESS_TO_USER)
  followedBusinessId String? // ID para Negocio seguido (setear si type USER_TO_BUSINESS)
  type              FollowType
  createdAt         DateTime @default(now())

  // Relaciones con map únicos
  follower          Usuario  @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followedUser      Usuario? @relation("FollowedUser", fields: [followedUserId], references: [id], onDelete: Cascade, map: "fk_follow_followed_user")
  followedBusiness  Negocio? @relation("FollowedBusiness", fields: [followedBusinessId], references: [id], onDelete: Cascade, map: "fk_follow_followed_business")

  @@unique([followerId, followedUserId])    // Único para user-user o business-user
  @@unique([followerId, followedBusinessId]) // Único para user-business
  @@index([followerId, type])
  @@index([followedUserId, type])
  @@index([followedBusinessId, type])
}

enum FollowType {
  USER_TO_BUSINESS    // Usuario sigue Negocio (principal)
  BUSINESS_TO_USER    // Negocio sigue Usuario (e.g., para marketing)
  USER_TO_USER        // Usuario sigue Usuario (social puro, si expands)
}



model BusinessAvailability {
  id                       String   @id @default(cuid())
  negocioId                String   @unique // FK a Negocio, asegura 1:1
  diasAtencion             String[] // Array de strings, e.g., ["Lunes", "Martes"]
  franjaMananaInicio       String? // Formato HH:mm, e.g., "08:00"
  franjaMananaFin          String? // Formato HH:mm, e.g., "12:00"
  franjaTardeInicio        String? // Formato HH:mm, e.g., "14:00"
  franjaTardeFin           String? // Formato HH:mm, e.g., "18:00"
  intervaloMinutos         Int // e.g., 15, 30
  capacidadPorIntervalo    Int // e.g., 1 para únicos, 10 para múltiples
  duracionMinimaIntervalos Int? // Opcional, e.g., 2 si ocupa múltiples slots
  camposCustom             Boolean  @default(false) // Activa fields extra en reservas
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  // Relación
  negocio Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@index([negocioId]) // Para queries rápidas por negocio
}

model Reservation {
  id              String            @id @default(cuid())
  negocioId       String // FK a Negocio
  usuarioId       String? // FK a User, opcional si guest
  nombre          String // Nombre del cliente
  telefono        String // Teléfono del cliente
  fechaHoraInicio DateTime // e.g., "2025-08-20T09:00:00Z"
  fechaHoraFin    DateTime? // Calculado, opcional si fijo por intervalo
  notas           String? // Opcional, e.g., "Motivo: consulta"
  estado          ReservationStatus @default(PENDIENTE) // Enum definido abajo
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relaciones
  negocio Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([negocioId, fechaHoraInicio]) // Para chequeos de overbooking por slot
  @@index([estado]) // Para filtros por estado en dashboards
}

enum ReservationStatus {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
  BLOQUEADA
}

model Transaction {
  id            String          @id @default(uuid())
  date          DateTime
  type          TransactionType
  description   String
  category      String // Almacena el valor del enum correspondiente (IncomeCategory o ExpenseCategory) como string
  amount        Decimal
  paymentMethod PaymentMethod
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  usuarioId     String
  orderId       String?         @unique
  order         Order? // 🔹 Campo inverso para relación con Order
  usuario       Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId]) // Índice para consultas rápidas por usuario
  @@index([type]) // Índice para filtrar por tipo (ingreso/gasto)
  @@index([date]) // Índice para ordenar por fecha
  @@index([usuarioId, date, type])
}

enum TransactionType {
  ingreso
  gasto
}

enum IncomeCategory {
  ventas
  ahorro
  otros
  propinas
  prestamos
}

enum ExpenseCategory {
  implementos
  materiales
  arriendo
  empleados
  servicios_publicos
  envios
  deudas
  mantenimiento
  impuestos
  otros
}

enum PaymentMethod {
  efectivo
  nequi
  daviplata
  cuenta_principal
  transferencias
}



enum EstadoNegocio {
  activo
  suspendido
  eliminado
}

model NegocioCategory {
  negocioId  String
  categoryId String
  negocio    Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])

  @@unique([negocioId, categoryId])
  @@index([categoryId])
}

model NegocioSection {
  negocioId String
  sectionId String
  negocio   Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  section   Section @relation("NegocioSection", fields: [sectionId], references: [id]) // ✅ se agregó el nombre
  prioridad Int     @default(0)

  @@unique([negocioId, sectionId])
  @@index([sectionId])
}

model Order {
  id             String               @id @default(uuid())
  date           DateTime             @default(now())
  status         OrderState           @default(Recibida)
  type           TransactionType // Herencia de TransactionType (solo ingreso por ahora?)
  TipoUsuario    TipoUsuario          @default(negocio)
  category       String               @default("ventas")
  description    String?
  totalAmount    Decimal
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  userId         String? // 🔹 Nuevo: Relación con comprador (Usuario)
  user           Usuario?             @relation(fields: [userId], references: [id], onDelete: SetNull) // 🔹 Nueva relación
  negocioId      String?
  negocio        Negocio?             @relation(fields: [negocioId], references: [id], onDelete: SetNull)
  transactionId  String?              @unique // Opcional: Liga a Transaction generada
  items          OrderItem[]
  datosDeEntrega DeliveryData?        @relation(fields: [deliveryDataId], references: [id], onDelete: Cascade)
  deliveryDataId String?              @unique // Debe ser único en una relación 1:1
  statusHistory  OrderStatusHistory[] // Relación con el historial de estados
  paymentMethod  PaymentMethod? // 🔹 Nuevo: Método de pago (e.g., "efectivo", "tarjeta")
  transaction    Transaction?         @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([negocioId, date])
  @@index([userId]) // 🔹 Nuevo: Para órdenes por usuario
  @@index([status])
}

enum TipoUsuario {
  negocio
  usuario
}

enum OrderState {
  Recibida
  Entregada
  Pagada
  Cancelada
  Preparacion
}

model OrderItem {
  id          String   @id @default(uuid())
  description String
  quantity    Int      @default(1)
  price       Decimal // Precio unitario al momento de venta (snapshot)
  subtotal    Decimal // price * quantity
  orderId     String
  productId   String? // Opcional: Si es producto
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId]) // Para métricas rápidas
}

model OrderStatusHistory {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  previousState String? // Cambiado a nullable
  newState      String
  comment       String?
  createdAt     DateTime @default(now())
}

model DeliveryData {
  id              String    @id @default(uuid())
  country         String    @default("Colombia")
  departamento    String
  ciudad          String
  clientName      String
  clientPhone     String
  deliveryAddress String
  deliveryDate    DateTime?
  additionalComments  String?
  order           Order?    @relation
}

model Product {
  id               String                   @id @default(uuid())
  nombre           String
  slug             String                   @unique
  descripcion      String
  descripcionCorta String?
  precio           Float
  currency         Currency                 @default(COP)
  prioridad        Int?
  status           ProductStatus            @default(disponible)
  etiquetaEspecial ProductEtiquetaEspecial? @default(ninguna)
  tags             String[]
  componentes      String[] // opcional: puede pasar a atributos
  imagenes         Image[]                  @relation("ProductImages")
  secciones        ProductSection[]
  disponibleDesde  DateTime?
  disponibleHasta  DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  negocioId        String
  categoryId       String

  negocio                   Negocio               @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  category                  Category              @relation(fields: [categoryId], references: [id])
  publicacionesRelacionadas PublicacionProducto[] // Sin @relation("ProductosEnPublicacion")
  orderItems                OrderItem[] // 🔹 Campo inverso para relación con OrderItem

  @@index([negocioId]) // Para filtrar productos por usuario rápidamente
  @@index([categoryId]) // Mejora las consultas filtradas por categoría
  @@index([nombre])
  @@index([status])
  @@index([categoryId, status])
  @@index([etiquetaEspecial])
  @@index([negocioId, status])
}

enum ProductStatus {
  disponible
  agotado
  oculto
  descontinuado
}

model ProductSection {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  prioridad Int     @default(0)

  @@unique([productId, sectionId]) // Añade esta línea si no está presente
}

enum ProductEtiquetaEspecial {
  mas_buscado
  mas_vendido
  novedad
  reciente
  promocion
  ultimos_dias
  ninguna
}

model Image {
  id        String  @id @default(uuid())
  url       String
  productId String
  product   Product @relation("ProductImages", fields: [productId], references: [id], onDelete: Cascade)
}

model Section {
  id       String           @id @default(uuid())
  nombre   String
  slug     String           @unique
  iconName String? // Nuevo campo opcional para el nombre del ícono
  order    Int // Orden o prioridad
  isActive Boolean // Estado activo/inactivo
  products ProductSection[]
  negocios NegocioSection[] @relation("NegocioSection")

  Category   Category? @relation(fields: [categoryId], references: [id])
  categoryId String?

  @@index([categoryId])
}

enum Currency {
  COP // Pesos colombianos
  USD // Dólar estadounidense
  EUR // Euro
  MXN // Peso mexicano
  ARS // Peso argentino
  BRL // Real brasileño
}



model Category {
  id        String    @id @default(uuid())
  nombre    String
  slug      String    @unique
  iconName  String? // Ícono opcional para UI
  secciones Section[]
  productos Product[] // Productos relacionados
  isActive  Boolean   @default(true) // ✅ AGREGAR ESTA LÍNEA

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  negocios  NegocioCategory[] // sin @relation (usa nombre implícito o explícito si lo necesitas)
}





// Apartado de publicaciones

model Publicacion {
  id                     String                @id @default(cuid())
  usuarioId              String
  usuario                Usuario               @relation(fields: [usuarioId], references: [id])
  negocioId              String? // Nuevo campo para asociar con Negocio
  negocio                Negocio?              @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  tipo                   PublicacionTipo
  titulo                 String?
  descripcion            String?
  multimedia             Media[] // Cambiado a Media
  visibilidad            Visibilidad           @default(PUBLICA)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  productosEnPublicacion PublicacionProducto[]
  numLikes               Int                   @default(0)
  numComentarios         Int                   @default(0)
  numCompartidos         Int                   @default(0)
  interacciones          Interaccion[]         @relation("PublicacionInteracciones")

  @@index([tipo, visibilidad, createdAt])
  @@index([usuarioId, createdAt])
  @@index([negocioId, createdAt])
}

enum Visibilidad {
  PUBLICA
  PRIVADA
  AMIGOS // O cualquier otra opción relevante
}

model PublicacionProducto {
  id            String      @id @default(cuid())
  publicacionId String
  productoId    String
  publicacion   Publicacion @relation(fields: [publicacionId], references: [id], onDelete: Cascade)
  producto      Product     @relation(fields: [productoId], references: [id], onDelete: Cascade)
  orden         Int         @default(0)

  @@unique([publicacionId, productoId])
}

enum PublicacionTipo {
  VIDEO_HORIZONTAL
  VIDEO_VERTICAL
  CARRUSEL_IMAGENES
  PRODUCTO_DESTACADO
  MINI_GRID
  TESTIMONIO
}

model Media {
  id            String         @id @default(uuid())
  url           String         @db.VarChar(2048)
  tipo          MultimediaTipo
  formato       String?
  orden         Int            @default(0)
  publicacionId String?
  servicioId    String?
  publicacion   Publicacion?   @relation(fields: [publicacionId], references: [id], onDelete: Cascade)
  servicio      Servicio?      @relation(fields: [servicioId], references: [id], onDelete: Cascade)
}

enum MultimediaTipo {
  IMAGEN
  VIDEO
}

model Servicio {
  id          String         @id @default(uuid())
  titulo      String // Título del servicio/experiencia
  descripcion String[] // Array de strings para párrafos separados
  slug        String         @unique // Para URLs amigables
  precio      Float? // Opcional: precio si aplica
  currency    Currency       @default(COP) // Reutilizando enum existente
  status      ServicioStatus @default(disponible) // Enum para estado
  tags        String[] // Etiquetas para búsqueda
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  negocioId   String // Relación con Negocio
  negocio     Negocio        @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  multimedia  Media[] // Relación con Media (imágenes/videos)

  @@index([negocioId]) // Para filtrar por negocio
  @@index([status]) // Para consultas por disponibilidad
  @@index([negocioId, status]) // Índice compuesto para eficiencia
}

enum ServicioStatus {
  disponible
  no_disponible
  oculto
  descontinuado
}

model Pregunta {
  id        String       @id @default(cuid())
  texto     String
  tipo      TipoPregunta // Enum: CALIFICABLE | TEXTO
  creador   Creador // Enum: ADMIN | NEGOCIO
  negocioId String?
  requerida Boolean      @default(false)
  orden     Int?
  categoria String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  negocio    Negocio?           @relation("NegocioPreguntas", fields: [negocioId], references: [id])
  encuestas  EncuestaPregunta[] // Relación pivot
  respuestas Respuesta[] // Respuestas a esta pregunta

  @@index([creador, negocioId])
}

enum TipoPregunta {
  CALIFICABLE
  TEXTO
}

enum Creador {
  ADMIN
  NEGOCIO
}

model Encuesta {
  id          String             @id @default(cuid())
  negocioId   String
  titulo      String
  descripcion String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  preguntas   EncuestaPregunta[] // Preguntas seleccionadas
  resenas     Resena[] // Reseñas basadas en esta encuesta
  negocio     Negocio            @relation("NegocioEncuestas", fields: [negocioId], references: [id])
  usuarioId   String?
  usuario     Usuario?           @relation("UsuarioEncuestas", fields: [usuarioId], references: [id])

  @@index([negocioId, createdAt])
}

model EncuestaPregunta {
  encuestaId String
  preguntaId String
  orden      Int?

  encuesta Encuesta @relation(fields: [encuestaId], references: [id])
  pregunta Pregunta @relation(fields: [preguntaId], references: [id])

  @@id([encuestaId, preguntaId]) // ID compuesto para unicidad
}

model Resena {
  id                 String   @id @default(cuid())
  encuestaId         String
  usuarioId          String?
  nombre             String?
  telefono           String?
  descripcionGeneral String?
  multimedia         String[] @default([])
  createdAt          DateTime @default(now())

  encuesta   Encuesta    @relation(fields: [encuestaId], references: [id])
  usuario    Usuario?    @relation(fields: [usuarioId], references: [id])
  respuestas Respuesta[]

  @@index([encuestaId, createdAt])
  @@index([usuarioId])
}

model Respuesta {
  id           String   @id @default(cuid())
  resenaId     String
  preguntaId   String
  valor        String?
  calificacion Int?
  resena       Resena   @relation(fields: [resenaId], references: [id])
  pregunta     Pregunta @relation(fields: [preguntaId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation("UsuarioRespuestas", fields: [usuarioId], references: [id])
}

model Interaccion {
  id            String          @id @default(cuid())
  tipo          InteraccionTipo
  contenido     String?         @db.Text // Cambiar a Text para soportar comentarios largos
  reaccionTipo  ReaccionTipo?
  usuarioId     String
  publicacionId String
  createdAt     DateTime        @default(now())

  usuario     Usuario     @relation("UsuarioInteracciones", fields: [usuarioId], references: [id])
  publicacion Publicacion @relation("PublicacionInteracciones", fields: [publicacionId], references: [id], onDelete: Cascade)

  @@index([publicacionId, createdAt]) // Índice compuesto para paginación y ordenamiento
  @@index([publicacionId, tipo]) // Índice para filtrar por tipo (ej. solo comentarios)
  @@index([usuarioId, createdAt]) // Índice para actividad del usuario
}

enum InteraccionTipo {
  COMENTARIO
  REACCION
  COMPARTIDO
}

enum ReaccionTipo {
  LIKE
  LOVE
  WOW
  SAD
  ANGRY
}
