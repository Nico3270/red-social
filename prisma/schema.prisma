generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id              String        @id @default(uuid())
  nombre          String
  apellido        String
  username        String        @unique
  contraseña     String
  email           String        @unique
  ciudad          String
  departamento    String
  pais            String?       @default("Colombia")
  genero          Genero
  fechaNacimiento DateTime
  fotoPerfil      String?
  biografia       String?
  role            Role          @default(user)
  facebook        String?
  instagram       String?
  tiktok          String?
  youtube         String?
  twitter         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  ultimaActividad DateTime      @default(now())
  estado          EstadoUsuario @default(activo)
  emailVerified   DateTime?
  preferencias    String[]
  encuestas       Encuesta[]    @relation("UsuarioEncuestas")
  followsOut      Follow[]      @relation("Follower")
  followsIn       Follow[]      @relation("FollowedUser")
  interacciones   Interaccion[] @relation("UsuarioInteracciones")
  negocio         Negocio?
  orders          Order[]
  publicaciones   Publicacion[]
  resenas         Resena[]
  reservations    Reservation[]
  respuestas      Respuesta[]   @relation("UsuarioRespuestas")
  Transaction     Transaction[]
  perfilCompleto  Boolean       @default(false)
  passwordResetTokens PasswordResetToken[] @relation("UserPasswordResetTokens")

  @@index([username])
  @@index([email])
  @@index([role])
  @@index([preferencias], type: Gin)
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      Usuario  @relation("UserPasswordResetTokens", fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)

  @@index([userId])
  @@index([expiresAt])
}


// Enums para estructurar datos categóricos
enum TipoContacto {
  CLIENTE
  LEAD
  PROVEEDOR
  OTRO
}

enum EstadoContacto {
  ACTIVO
  INACTIVO
  PENDIENTE
}

// Modelo Contactos
model Contactos {
  id                 Int            @id @default(autoincrement())
  nombre             String
  departamento       String
  municipio          String
  direccion          String
  correo             String         @unique
  identificacion     String         @unique
  telefono           String?
  categoria          String? 

  promocionalEnviado   Boolean        @default(false)
  brevoMessageId       String?        // ID único del correo en Brevo
  emailEstado          String?        // Ej: "enviado", "entregado", "abierto", "clic", "rebotado"
  entregadoEn          DateTime?
  abiertoEn            DateTime?
  clicEn               DateTime?
  reboteRazon          String?
  ultimoEventoBrevo  DateTime?      // Fecha del último evento recibido de Brevo
  

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  notas              String?
  tipoContacto       TipoContacto?  @default(OTRO)
  estado             EstadoContacto @default(ACTIVO)
  negocioId          String?        // 👈 debe coincidir con el tipo de id de Negocio
  Negocio            Negocio?       @relation(fields: [negocioId], references: [id], onDelete: SetNull)
  @@index([correo])
  @@index([identificacion])
  @@index([negocioId])
}



model BusinessAvailability {
  id                       String   @id @default(cuid())
  negocioId                String   @unique
  diasAtencion             String[]
  franjaMananaInicio       String?
  franjaMananaFin          String?
  franjaTardeInicio        String?
  franjaTardeFin           String?
  intervaloMinutos         Int
  capacidadPorIntervalo    Int
  duracionMinimaIntervalos Int?
  camposCustom             Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  negocio                  Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@index([negocioId])
}

model Reservation {
  id              String            @id @default(cuid())
  negocioId       String
  usuarioId       String?
  nombre          String
  telefono        String
  fechaHoraInicio DateTime
  fechaHoraFin    DateTime?
  notas           String?
  estado          ReservationStatus @default(PENDIENTE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  negocio         Negocio           @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  usuario         Usuario?          @relation(fields: [usuarioId], references: [id])

  @@index([negocioId, fechaHoraInicio])
  @@index([estado])
}

model Transaction {
  id            String          @id @default(uuid())
  date          DateTime
  type          TransactionType
  description   String
  category      String
  amount        Decimal
  paymentMethod PaymentMethod
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  usuarioId     String
  orderId       String?         @unique
  order         Order?
  usuario       Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([type])
  @@index([date])
  @@index([usuarioId, date, type])
}

model Order {
  id             String               @id @default(uuid())
  date           DateTime             @default(now())
  description    String?
  totalAmount    Decimal
  paymentMethod  PaymentMethod?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  negocioId      String?
  deliveryDataId String?              @unique
  userId         String?
  TipoUsuario    TipoUsuario          @default(negocio)
  transactionId  String?              @unique
  category       String               @default("ventas")
  status         OrderState           @default(Recibida)
  type           TransactionType
  datosDeEntrega DeliveryData?        @relation(fields: [deliveryDataId], references: [id], onDelete: Cascade)
  negocio        Negocio?             @relation(fields: [negocioId], references: [id])
  transaction    Transaction?         @relation(fields: [transactionId], references: [id])
  user           Usuario?             @relation(fields: [userId], references: [id])
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  orderType      OrderType            @default(DELIVERY)

  @@index([negocioId, date])
  @@index([userId])
  @@index([status])
  @@index([orderType])
}

model OrderItem {
  id          String   @id @default(uuid())
  description String
  quantity    Int      @default(1)
  price       Decimal
  subtotal    Decimal
  orderId     String
  productId   String?
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

enum OrderType {
  DELIVERY
  ON_SITE
}

model OrderStatusHistory {
  id            String   @id @default(uuid())
  orderId       String
  previousState String?
  newState      String
  comment       String?
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model DeliveryData {
  id                 String    @id @default(uuid())
  clientName         String
  clientPhone        String
  deliveryAddress    String? // Opcional para pedidos en sitio
  onSiteLocation     String? // Referencia para pedidos en sitio (e.g., "Mesa 4")
  deliveryDate       DateTime?
  ciudad             String? // Ahora opcional
  country            String?   @default("Colombia") // Opcional con valor por defecto
  departamento       String? // Ahora opcional
  additionalComments String?
  order              Order?
}

model Product {
  id                        String                   @id @default(uuid())
  nombre                    String
  slug                      String                   @unique
  descripcion               String
  descripcionCorta          String?
  precio                    Float
  currency                  Currency                 @default(COP)
  prioridad                 Int?
  status                    ProductStatus            @default(disponible)
  etiquetaEspecial          ProductEtiquetaEspecial? @default(ninguna)
  tags                      String[]
  componentes               String[]
  disponibleDesde           DateTime?
  disponibleHasta           DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  categoryId                String
  negocioId                 String
  orden                     Float                    @default(8.0)
  imagenes                  Image[]                  @relation("ProductImages")
  orderItems                OrderItem[]
  category                  Category                 @relation(fields: [categoryId], references: [id])
  negocio                   Negocio                  @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  secciones                 ProductSection[]
  publicacionesRelacionadas PublicacionProducto[]
  ratingPromedio Float? // Calculado: promedio de calificaciones de reseñas asociadas
  numResenas     Int    @default(0) // Contador de reseñas

  @@index([negocioId])
  @@index([categoryId])
  @@index([nombre])
  @@index([status])
  @@index([categoryId, status])
  @@index([etiquetaEspecial])
  @@index([negocioId, status])
  @@index([negocioId, createdAt])
  @@index([orden(sort: Desc), createdAt(sort: Desc)])
  @@index([tags], type: Gin)
  @@index([componentes], type: Gin)

}

model ProductSection {
  id        String  @id @default(uuid())
  productId String
  sectionId String
  prioridad Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([productId, sectionId])
}

model Image {
  id        String  @id @default(uuid())
  url       String
  productId String
  product   Product @relation("ProductImages", fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Section {
  id         String           @id @default(uuid())
  nombre     String
  slug       String           @unique
  iconName   String?
  order      Int
  isActive   Boolean
  categoryId String?
  negocios   NegocioSection[] @relation("NegocioSection")
  products   ProductSection[]
  Category   Category?        @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
}

model Follow {
  id                 String     @id @default(cuid())
  followerId         String
  type               FollowType
  createdAt          DateTime   @default(now())
  followedBusinessId String?
  followedUserId     String?
  follower           Usuario    @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followedBusiness   Negocio?   @relation("FollowedBusiness", fields: [followedBusinessId], references: [id], onDelete: Cascade, map: "fk_follow_followed_business")
  followedUser       Usuario?   @relation("FollowedUser", fields: [followedUserId], references: [id], onDelete: Cascade, map: "fk_follow_followed_user")

  @@unique([followerId, followedUserId])
  @@unique([followerId, followedBusinessId])
  @@index([followerId, type])
  @@index([followedUserId, type])
  @@index([followedBusinessId, type])
  @@index([followedBusinessId])
}

model Publicacion {
  id                     String                @id @default(cuid())
  usuarioId              String
  negocioId              String?
  tipo                   PublicacionTipo
  titulo                 String?
  descripcion            String?
  visibilidad            Visibilidad           @default(PUBLICA)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  numLikes               Int                   @default(0)
  numComentarios         Int                   @default(0)
  numCompartidos         Int                   @default(0)
  orden                  Float                 @default(8.0)
  interacciones          Interaccion[]         @relation("PublicacionInteracciones")
  multimedia             Media[]
  calificacion Int? // Nueva: para estrellas (1-5)
  negocio                Negocio?              @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  usuario                Usuario               @relation(fields: [usuarioId], references: [id])
  productosEnPublicacion PublicacionProducto[]

  @@index([tipo, visibilidad, createdAt])
  @@index([usuarioId, createdAt])
  @@index([negocioId, createdAt])
  @@index([negocioId, visibilidad, createdAt])
  @@index([orden(sort: Desc), createdAt(sort: Desc)])
}

model PublicacionProducto {
  id            String      @id @default(cuid())
  publicacionId String
  productoId    String
  orden         Int         @default(0)
  esResena      Boolean  @default(false) // Nueva: indica si es reseña del producto
  producto      Product     @relation(fields: [productoId], references: [id], onDelete: Cascade)
  publicacion   Publicacion @relation(fields: [publicacionId], references: [id], onDelete: Cascade)

  @@unique([publicacionId, productoId])
  @@index([productoId])
}

model Media {
  id            String         @id @default(uuid())
  url           String         @db.VarChar(2048)
  tipo          MultimediaTipo
  formato       String?
  orden         Int            @default(0)

  publicacionId String?
  servicioId    String?
  publicacion   Publicacion?   @relation(fields: [publicacionId], references: [id], onDelete: Cascade)
  servicio      Servicio?      @relation(fields: [servicioId], references: [id], onDelete: Cascade)

  @@index([publicacionId])
  @@index([publicacionId, tipo])
}

model Interaccion {
  id            String          @id @default(cuid())
  tipo          InteraccionTipo
  contenido     String?
  reaccionTipo  ReaccionTipo?
  usuarioId     String
  publicacionId String
  createdAt     DateTime        @default(now())
  publicacion   Publicacion     @relation("PublicacionInteracciones", fields: [publicacionId], references: [id], onDelete: Cascade)
  usuario       Usuario         @relation("UsuarioInteracciones", fields: [usuarioId], references: [id])

  @@index([publicacionId, createdAt])
  @@index([publicacionId, tipo])
  @@index([usuarioId, createdAt])
  @@index([publicacionId, reaccionTipo])
}

model Negocio {
  id               String                @id @default(uuid())
  usuarioId        String                @unique
  nombre           String
  descripcion      String?
  ciudad           String
  departamento     String
  direccion        String?
  urlGoogleMaps    String?
  horarios         Json?
  imagenes         String[]
  sitioWeb         String?
  telefonoContacto String?
  estado           EstadoNegocio         @default(activo)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  slug             String                @unique
  fotoPerfil       String?
  fotoPortada      String?
  latitud          Float?
  longitud         Float?
  availability     BusinessAvailability?
  encuestas        Encuesta[]            @relation("NegocioEncuestas")
  followsIn        Follow[]              @relation("FollowedBusiness")
  usuario          Usuario               @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  categorias       NegocioCategory[]
  secciones        NegocioSection[]
  orden            Float                 @default(8.0)
  orders           Order[]
  preguntas        Pregunta[]            @relation("NegocioPreguntas")
  Product          Product[]
  publicaciones    Publicacion[]
  reservations     Reservation[]
  Servicio         Servicio[]
  tipo             TipoNegocio              @default(NEGOCIO)
  contactos Contactos[]

  @@index([ciudad])
  @@index([departamento])
  @@index([estado])
  @@index([usuarioId])
  @@index([estado, createdAt])
  @@index([orden(sort: Desc), createdAt(sort: Desc)])
  @@index([nombre])
}

enum TipoNegocio {
  NEGOCIO
  PROFESIONAL
}


model Servicio {
  id          String         @id @default(uuid())
  titulo      String
  descripcion String[]
  slug        String         @unique
  precio      Float?
  currency    Currency       @default(COP)
  status      ServicioStatus @default(disponible)
  tags        String[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  negocioId   String
  multimedia  Media[]
  negocio     Negocio        @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  orden       Float          @default(8.0)

  @@index([negocioId])
  @@index([status])
  @@index([negocioId, status])
  @@index([orden(sort: Desc), createdAt(sort: Desc)])
  @@index([tags], type: Gin)
  @@index([descripcion], type: Gin)

}

model NegocioCategory {
  negocioId  String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  negocio    Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@unique([negocioId, categoryId])
  @@index([categoryId])
}

model NegocioSection {
  negocioId String
  sectionId String
  prioridad Int     @default(0)
  negocio   Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  section   Section @relation("NegocioSection", fields: [sectionId], references: [id])

  @@unique([negocioId, sectionId])
  @@index([sectionId])
}

model Category {
  id        String            @id @default(uuid())
  nombre    String
  slug      String            @unique
  iconName  String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  isActive  Boolean           @default(true)
  negocios  NegocioCategory[]
  productos Product[]
  secciones Section[]

  @@index([slug])
}

model Pregunta {
  id         String             @id @default(cuid())
  texto      String
  tipo       TipoPregunta
  creador    Creador
  negocioId  String?
  requerida  Boolean            @default(false)
  orden      Int?
  categoria  String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  encuestas  EncuestaPregunta[]
  negocio    Negocio?           @relation("NegocioPreguntas", fields: [negocioId], references: [id])
  respuestas Respuesta[]

  @@index([creador, negocioId])
}

model Encuesta {
  id          String             @id @default(cuid())
  negocioId   String
  titulo      String
  descripcion String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  usuarioId   String?
  negocio     Negocio            @relation("NegocioEncuestas", fields: [negocioId], references: [id])
  usuario     Usuario?           @relation("UsuarioEncuestas", fields: [usuarioId], references: [id])
  preguntas   EncuestaPregunta[]
  resenas     Resena[]

  @@index([negocioId, createdAt])
}

model EncuestaPregunta {
  encuestaId String
  preguntaId String
  orden      Int?
  encuesta   Encuesta @relation(fields: [encuestaId], references: [id])
  pregunta   Pregunta @relation(fields: [preguntaId], references: [id])

  @@id([encuestaId, preguntaId])
}

model Resena {
  id                 String      @id @default(cuid())
  encuestaId         String
  usuarioId          String?
  nombre             String?
  telefono           String?
  descripcionGeneral String?
  multimedia         String[]    @default([])
  createdAt          DateTime    @default(now())
  encuesta           Encuesta    @relation(fields: [encuestaId], references: [id])
  usuario            Usuario?    @relation(fields: [usuarioId], references: [id])
  respuestas         Respuesta[]

  @@index([encuestaId, createdAt])
  @@index([usuarioId])
}

model Respuesta {
  id           String   @id @default(cuid())
  resenaId     String
  preguntaId   String
  valor        String?
  usuarioId    String?
  calificacion Int?
  pregunta     Pregunta @relation(fields: [preguntaId], references: [id])
  resena       Resena   @relation(fields: [resenaId], references: [id])
  usuario      Usuario? @relation("UsuarioRespuestas", fields: [usuarioId], references: [id])
}

enum EstadoUsuario {
  activo
  suspendido
  eliminado
}

enum Role {
  admin
  user
  navegante
  creador
  negocio
}

enum Genero {
  masculino
  femenino
  otro
}

enum ReservationStatus {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
  BLOQUEADA
}

enum TransactionType {
  ingreso
  gasto
}

enum IncomeCategory {
  ventas
  ahorro
  otros
  propinas
  prestamos
}

enum ExpenseCategory {
  implementos
  materiales
  arriendo
  empleados
  servicios_publicos
  envios
  deudas
  mantenimiento
  impuestos
  otros
}

enum PaymentMethod {
  efectivo
  nequi
  daviplata
  cuenta_principal
  transferencias
}

enum TipoUsuario {
  negocio
  usuario
}

enum OrderState {
  Recibida
  Entregada
  Pagada
  Cancelada
  Preparacion
}

enum ProductStatus {
  disponible
  agotado
  oculto
  descontinuado
}

enum ProductEtiquetaEspecial {
  mas_buscado
  mas_vendido
  novedad
  reciente
  promocion
  ultimos_dias
  ninguna
}

enum Currency {
  COP
  USD
  EUR
  MXN
  ARS
  BRL
}

enum FollowType {
  USER_TO_BUSINESS
  BUSINESS_TO_USER
  USER_TO_USER
}

enum Visibilidad {
  PUBLICA
  PRIVADA
  AMIGOS
}

enum PublicacionTipo {
  VIDEO_HORIZONTAL
  VIDEO_VERTICAL
  CARRUSEL_IMAGENES
  PRODUCTO_DESTACADO
  MINI_GRID
  TESTIMONIO
}

enum InteraccionTipo {
  COMENTARIO
  REACCION
  COMPARTIDO
}

enum ReaccionTipo {
  LIKE
  LOVE
  WOW
  SAD
  ANGRY
}

enum MultimediaTipo {
  IMAGEN
  VIDEO
}

enum EstadoNegocio {
  activo
  suspendido
  eliminado
}

enum ServicioStatus {
  disponible
  no_disponible
  oculto
  descontinuado
}

enum TipoPregunta {
  CALIFICABLE
  TEXTO
}

enum Creador {
  ADMIN
  NEGOCIO
}
